FROM python:3.11-slim

RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy requirements first — layer caching means pip only re-runs when this changes
COPY dashboards/requirements.txt ./requirements.txt

RUN pip install --no-cache-dir \
    streamlit \
    plotly \
    redshift_connector \
    boto3

EXPOSE 8501

# Streamlit must bind to 0.0.0.0 inside Docker to be reachable from the host
CMD ["streamlit", "run", "app.py", "--server.address=0.0.0.0", "--server.port=8501"]
